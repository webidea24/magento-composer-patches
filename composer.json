{
    "name": "webidea24/magento-composer-patches",
    "description": "Builds and synchronizes remote Magento Composer patches.",
    "type": "composer-plugin",
    "keywords": ["dev", "magento"],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "composer-plugin-api": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Webidea24\\MagentoComposerPatches\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webidea24\\MagentoComposerPatches\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "rector/rector": "*",
        "symplify/easy-coding-standard": "*"
    },
    "scripts": {
        "test": "phpunit",
        "build-patches": "php bin/build-patches.php"
    },
    "extra": {
        "class": "Webidea24\\MagentoComposerPatches\\MagentoComposerPatchesPlugin"
    }
}
